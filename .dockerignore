.git
.gitignore

# Environment variables
**/.env
**/.env.*
!**/.env.example

# Python cache (using ** to catch these in any subdirectory)
**/__pycache__/
**/*.pyc
**/*.pyo

# Virtual environments
**/.venv
**/venv
**/env

node_modules/

# Testing and formatting caches
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Explicit backend data/temp paths based on your structure
backend/ml/dataset/
backend/ml/datasets/
backend/temp/
backend/uploads/

# Ignore heavy ML checkpoints
backend/ml/artifacts/*/checkpoints/

*.log

.vscode/
.idea/

README.md